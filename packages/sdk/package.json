{
  "name": "neogate-sdk",
  "version": "0.1.0",
  "description": "TypeScript client for the Neogate DDoS-protection panel API",
  "license": "MIT",
  "homepage": "https://github.com/xdearboy/neogate-sdk/tree/main/packages/sdk#readme",
  "repository": { "type": "git", "url": "git+https://github.com/xdearboy/neogate-sdk.git", "directory": "packages/sdk" },
  "bugs": "https://github.com/xdearboy/neogate-sdk/issues",
  "keywords": ["neogate", "ddos", "ddos-protection", "waf", "sdk", "api-client"],
  "publishConfig": { "access": "public" },
  "type": "module",
  "sideEffects": false,
  "engines": { "node": ">=20" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  }
}
