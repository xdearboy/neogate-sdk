{
  "name": "@neogate/sdk",
  "version": "0.1.0",
  "description": "TypeScript client for the Neogate DDoS-protection panel API",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": { "node": ">=20" },
  "main": "./dist/index.js",
