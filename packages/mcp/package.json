  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.0",
    "neogate-sdk": "workspace:*",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0"
  }
}
