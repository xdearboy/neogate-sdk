{
  "name": "neogate-mcp",
  "version": "0.1.0",
  "description": "MCP server for Neogate: let Claude and other agents read attacks, traffic and protection settings",
  "license": "MIT",
  "homepage": "https://github.com/xdearboy/neogate-sdk/tree/main/packages/mcp#readme",
  "repository": { "type": "git", "url": "git+https://github.com/xdearboy/neogate-sdk.git", "directory": "packages/mcp" },
  "bugs": "https://github.com/xdearboy/neogate-sdk/issues",
  "keywords": ["mcp", "mcp-server", "model-context-protocol", "neogate", "ddos", "claude", "codex", "cursor"],
  "publishConfig": { "access": "public" },
  "type": "module",
  "engines": { "node": ">=20" },
  "bin": { "neogate-mcp": "./dist/bin.js" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
